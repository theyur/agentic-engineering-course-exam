@* A Lucide 0.460.0 line icon (ISC license) from design/icons, for the names the app uses. Always decorative. *@
<svg class="@CssClass" viewBox="0 0 24 24" aria-hidden="true">
    @switch (Name)
    {
        case "circle-alert":
            <circle cx="12" cy="12" r="10" /><line x1="12" x2="12" y1="8" y2="12" /><line x1="12" x2="12.01" y1="16" y2="16" />
            break;
        case "list-checks":
            <path d="m3 17 2 2 4-4" /><path d="m3 7 2 2 4-4" /><path d="M13 6h8" /><path d="M13 12h8" /><path d="M13 18h8" />
            break;
        case "user":
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
            break;
        case "log-out":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" x2="9" y1="12" y2="12" />
            break;
        case "menu":
            <line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="18" y2="18" />
            break;
        case "x":
            <path d="M18 6 6 18" /><path d="m6 6 12 12" />
            break;
        case "shield":
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
            break;
        default:
            throw new ArgumentOutOfRangeException(nameof(Name), Name, "Unknown icon.");
    }
</svg>

@code {
    /// <summary>The Lucide icon name.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Small (16px), default (20px) or large (24px).</summary>
    [Parameter]
    public IconSize Size { get; set; } = IconSize.Default;

    private string CssClass => Size switch
    {
        IconSize.Small => "ht-icon ht-icon--sm",
        IconSize.Large => "ht-icon ht-icon--lg",
        _ => "ht-icon",
    };

    public enum IconSize
    {
        Default,
        Small,
        Large,
    }
}
