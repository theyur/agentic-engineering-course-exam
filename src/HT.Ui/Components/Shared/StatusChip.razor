@* design/components/StatusChip (slice-6 and slice-7 states, HP-002, HP-003; slice 7 HP-006): the evaluation state of
   one commitment or period, or the exemption in its place, always as a word with its colour, never the colour alone.
   The word comes from ReportText.State ("Upcoming" for Upcoming, slice 5's RecordingText.State word for every other
   state, "Excused" and "Paused" included); the classes are the design's
   ht-chip ht-status ht-status--{met|failed|missed|excused|paused|pending|due}, and no other. Upcoming shares
   ht-status--due with Due; its word tells them apart. *@
@using HT.Application.Reports
@using HT.Domain.Evaluation
@using HT.Domain.Goals
@using HT.Domain.Habits
<span class="ht-chip ht-status @Modifier">@ReportText.State(State, ScheduleKind, Period)</span>

@code {
    [Parameter, EditorRequired]
    public EvaluationState State { get; set; }

    /// <summary>Commitment-based or period-based; with <see cref="Period"/> it tells "Due today" from "Due this week".</summary>
    [Parameter, EditorRequired]
    public GoalScheduleKind ScheduleKind { get; set; }

    /// <summary>The length of a period-based goal's period (day or week); null for a commitment-based goal.</summary>
    [Parameter]
    public SchedulePeriod? Period { get; set; }

    private string Modifier => State switch
    {
        EvaluationState.Met => "ht-status--met",
        EvaluationState.Failed => "ht-status--failed",
        EvaluationState.Missed => "ht-status--missed",
        EvaluationState.Excused => "ht-status--excused",
        EvaluationState.Paused => "ht-status--paused",
        EvaluationState.Pending => "ht-status--pending",
        EvaluationState.Due or EvaluationState.Upcoming => "ht-status--due",
        _ => throw new InvalidOperationException("The state has no chip."),
    };
}
