@typeparam TValue where TValue : struct
@* design/components/ChoiceCard: radio options shown as cards with a title and one line of description, in
   div.ht-choices[role=radiogroup]: label.ht-choice with a native input[type=radio], ht-choice__title and
   ht-choice__desc. The native radio shows the choice and takes the keyboard (Tab into the group, arrows between
   its options); the accent border and fill only repeat it. None is checked until the user chooses. Slice 8
   (design/components/EndGoalDialog): OneColumn stacks the cards in one column, as the design's inline
   grid-template-columns:1fr does, and FocusFirstAsync moves the focus to the first radio for a dialog whose first
   field the group is. *@
<div class="ht-choices" style="@(OneColumn ? OneColumnStyle : null)" role="radiogroup" aria-labelledby="@LabelledBy" aria-describedby="@DescribedBy">
    @for (var index = 0; index < Options.Count; index++)
    {
        var option = Options[index];
        <label class="ht-choice">
            @if (index == 0)
            {
                <input type="radio" name="@Name" checked="@Equals(option.Value, Value)" @ref="_first" @onchange="() => ValueChanged.InvokeAsync(option.Value)" />
            }
            else
            {
                <input type="radio" name="@Name" checked="@Equals(option.Value, Value)" @onchange="() => ValueChanged.InvokeAsync(option.Value)" />
            }
            <span class="ht-choice__title">@option.Title</span>
            <span class="ht-choice__desc">@option.Description</span>
        </label>
    }
</div>

@code {
    /// <summary>The design's one-column grid (design/components/EndGoalDialog).</summary>
    private const string OneColumnStyle = "grid-template-columns:1fr";

    private ElementReference _first;

    /// <summary>The 2 to 4 options in order, each with its title and a few words of description.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<(TValue Value, string Title, string Description)> Options { get; set; } = [];

    /// <summary>The chosen option; null until the user chooses.</summary>
    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>The radios' shared name, unique on the page.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>The id of the heading that names the group ("How do you measure it?").</summary>
    [Parameter, EditorRequired]
    public string LabelledBy { get; set; } = string.Empty;

    /// <summary>The id of an error text about this choice.</summary>
    [Parameter]
    public string? DescribedBy { get; set; }

    /// <summary>Stacks the cards in one column instead of the auto-fit grid (slice 8, EndGoalDialog).</summary>
    [Parameter]
    public bool OneColumn { get; set; }

    /// <summary>Moves the focus to the first radio, for a dialog whose first field the group is (design/components/Dialog).</summary>
    public ValueTask FocusFirstAsync() => _first.FocusAsync();
}
