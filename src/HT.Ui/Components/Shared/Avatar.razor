@* The avatar: the first letter of the account's name in upper case, or of its email without a name (HP-017). *@
<span class="@(Large ? "ht-avatar ht-avatar--lg" : "ht-avatar")" role="img" aria-label="@AriaLabel">@LetterOf(Name, Email)</span>

@code {
    /// <summary>The account's email (normal form).</summary>
    [Parameter, EditorRequired]
    public string Email { get; set; } = string.Empty;

    /// <summary>The account's own name; null when it has none.</summary>
    [Parameter]
    public string? Name { get; set; }

    /// <summary>The 56px size of the Profile header.</summary>
    [Parameter]
    public bool Large { get; set; }

    private string AriaLabel => "Account of " + Email;

    /// <summary>
    /// The first character of the name, or of the email when there is no name, upper-cased with
    /// <see cref="char.ToUpperInvariant"/> (HP-017).
    /// </summary>
    public static string LetterOf(string? name, string email)
    {
        var source = string.IsNullOrEmpty(name) ? email : name;
        return string.IsNullOrEmpty(source) ? string.Empty : char.ToUpperInvariant(source[0]).ToString();
    }
}
