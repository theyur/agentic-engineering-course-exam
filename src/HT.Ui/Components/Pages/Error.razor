@page "/Error"

@* No request id, exception detail, environment or configuration value (HP-016, HP-017). *@
<PageTitle>Something went wrong · Habit Tracker</PageTitle>

<div class="ht-container">
    <div class="ht-empty-page">
        <EmptyState IsPageHeading="true"
                    Title="Something went wrong"
                    Text="The page could not be shown. Try again later, or go to Home.">
            <HtButton Href="/">Go to Home</HtButton>
        </EmptyState>
    </div>
</div>
