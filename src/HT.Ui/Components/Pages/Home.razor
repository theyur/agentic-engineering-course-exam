@page "/"
@using HT.Application.Accounts
@using HT.Application.Goals
@using HT.Application.Habits
@using HT.Application.Reports
@using HT.Domain.Accounts
@using HT.Ui.Account
@using HT.Ui.Components.Goals
@using HT.Ui.Components.Reports
@using Microsoft.AspNetCore.Components.Authorization
@inject CatalogService Catalog
@inject ReportService Reports
@inject ProfileService Profiles
@inject ActingUserAccessor ActingUsers
@* One address for both Homes (HP-009). Static: the services are injected directly. The visitor Home: the hero,
   "How it works" and "Popular in the catalog" with the wording of design/pages/PageHomeVisitor, slice 2 state
   (HP-012, ADR 0008), and in the hero slice 6's ExampleGoalCard, with or without Published habits (HP-004, D-3). *@
<PageTitle>Habit Tracker</PageTitle>

<AuthorizeView>
    <Authorized>
        @* design/pages/PageHomeSignedIn, slice 6 state: the greeting as heading-1 and today's date, both from the use
           case at the current time in the account's time zone (slice 4 HP-010, FR-029); for a registered user with no
           goals the EmptyState of the Goals page; for one with goals (slice 6 HP-003, contracts/host.md "Signed-in Home")
           the ht-home grid: the TodayPanel island (tiles and Today card, interactive and prerendered, reading the
           dashboard itself) and the static right column, the "Active goals" card and the "Recent notes" card (absent
           without a note), from the page's own dashboard read, so they follow a save on the next page load. An
           administrator's Home has the page head only. A session whose account is gone gets no greeting, only the slice 1
           heading. *@
        <div class="ht-container">
            @if (_heading?.Heading is { } heading)
            {
                <div class="ht-page-head"><h1>@heading.Greeting</h1><span class="ht-muted">@heading.Date</span></div>
            }
            else
            {
                <div class="ht-page-head"><h1>Today</h1></div>
            }
            @if (_dashboard?.Dashboard is { } dashboard)
            {
                if (dashboard.Counts.Goals == 0)
                {
                    <NoGoalsEmptyState />
                }
                else
                {
                    <div class="ht-home">
                        <TodayPanel />
                        <div class="ht-stack">
                            <GoalSummary Goals="dashboard.Goals" />
                            <RecentNotesList Notes="dashboard.Notes" />
                        </div>
                    </div>
                }
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <section class="ht-hero">
            <div class="ht-hero__inner">
                <div>
                    <h1>Keep the habits you choose</h1>
                    <p class="ht-hero__text">Set a goal to build or reduce a habit, record what really happened, and see how consistent you are over time.</p>
                    <div class="ht-hero__cta">
                        <HtButton Href="/register">Register free</HtButton>
                        <HtButton Href="/catalog" Variant="HtButton.ButtonVariant.Secondary">Browse the catalog</HtButton>
                    </div>
                    <p class="ht-hero__fine">Your goals and notes stay private. Community comparison is opt-in.</p>
                </div>
                <ExampleGoalCard />
            </div>
        </section>
        <div class="ht-container">
            <section class="ht-section">
                <div class="ht-section__head"><h2>How it works</h2></div>
                <div class="ht-steps">
                    <div class="ht-step"><div class="ht-step__n">1</div><h3>Pick a habit</h3><p>Start from the catalog or write your own. Choose build or reduce.</p></div>
                    <div class="ht-step"><div class="ht-step__n">2</div><h3>Record what happened</h3><p>Yes/no, a count or minutes. Partial progress is kept. You have 48 hours to add late records.</p></div>
                    <div class="ht-step"><div class="ht-step__n">3</div><h3>See your consistency</h3><p>Streaks and a clear percentage, like 90% (18 of 20).</p></div>
                </div>
            </section>
            @if (_preview is { Habits.Count: > 0 } preview)
            {
                @* The Home preview of FR-008; the page only renders it. The compact cards of the design carry no description. *@
                <section class="ht-section">
                    <div class="ht-section__head"><h2>Popular in the catalog</h2><a href="/catalog">@($"See all {preview.PublishedCount} →")</a></div>
                    <div class="ht-grid-4">
                        @foreach (var habit in preview.Habits)
                        {
                            <HabitCard Icon="@habit.Icon" Name="@habit.Name" Category="@habit.Category.ToString()"
                                       Intent="@habit.Intent.ToString()"
                                       SuggestedStartingGoal="@habit.MarkedSuggestedStartingGoal?.Text"
                                       Variant="HabitCard.HabitCardVariant.Visitor" Href="@($"/catalog/{habit.Id.Value}")" />
                        }
                    </div>
                </section>
            }
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private HomePreviewResult? _preview;
    private DashboardResult? _dashboard;
    private HomeHeadingResult? _heading;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            _preview = await Catalog.GetHomePreviewAsync(CancellationToken.None);
        }
        else
        {
            var actingUser = await ActingUsers.GetAsync();
            _heading = await Profiles.GetHomeHeadingAsync(actingUser, CancellationToken.None);
            if (!user.IsInRole(nameof(Role.Administrator)))
            {
                // Whether the registered user has goals is the use case's answer; a refusal shows nothing more.
                _dashboard = await Reports.GetDashboardAsync(actingUser, CancellationToken.None);
            }
        }
    }
}
