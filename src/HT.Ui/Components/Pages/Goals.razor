@page "/goals"
@attribute [Authorize]
@using HT.Application.Goals
@using HT.Ui.Account
@using HT.Ui.Components.Goals
@using HT.Ui.Components.Reports
@using Microsoft.AspNetCore.Authorization
@inject GoalService GoalService
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageGoals, slice 6 state (HP-002, contracts/host.md "Goals page"): the static shell. "Goals" with no
   Tabs (Paused and Ended come in slices 7 and 8); for a user with goals, the GoalsList island, interactive and
   prerendered, which reads the goals overview itself and lists the full GoalItems in its order (FR-011), then the
   static footnote; for a user with no goals, slice 4's EmptyState with no footnote. The shell reads slice 4's goal list
   only to tell these apart. An administrator gets the Not found page; the use case refuses on its own (FR-021). An
   anonymous request never gets here: the endpoint's [Authorize] sends it to Sign in. *@
<PageTitle>Goals · Habit Tracker</PageTitle>

@if (_result is { } result)
{
    <div class="ht-container">
        <div class="ht-page-head"><h1>Goals</h1></div>
        @if (result.Goals.Count == 0)
        {
            <NoGoalsEmptyState />
        }
        else
        {
            <GoalsList />
            <p class="ht-footnote">Each goal is counted on its own. Consistency counts only finalized results; pending ones are left out.</p>
        }
    </div>
}

@code {
    private GoalListResult? _result;

    protected override async Task OnInitializedAsync()
    {
        var result = await GoalService.ListAsync(await ActingUsers.GetAsync(), CancellationToken.None);
        if (result.Outcome != GoalListOutcome.Found)
        {
            Navigation.NotFound();
            return;
        }

        _result = result;
    }
}
