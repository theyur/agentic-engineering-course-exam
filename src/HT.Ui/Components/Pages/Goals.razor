@page "/goals"
@attribute [Authorize]
@using HT.Application.Goals
@using HT.Application.Reports
@using HT.Ui.Account
@using HT.Ui.Components.Goals
@using HT.Ui.Components.Reports
@using Microsoft.AspNetCore.Authorization
@inject GoalService GoalService
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageGoals, slice 7 state (HP-004, contracts/host.md "Goals page"): the static shell. "Goals"; for a user
   with goals, the GoalsList island, interactive and prerendered, which reads the goals overview itself and shows the
   Tabs "Active" and "Paused" with their lists (FR-011, FR-018); the shell passes it only the address's tab value
   (?tab=paused), never a view (slice 6 research R-12). Then the static footnote (ReportText.GoalsFootnote), under
   either tab. For a user with no goals, slice 4's EmptyState in place of the tabs, with no footnote. The shell reads
   slice 4's goal list only to tell these apart. An administrator gets the Not found page; the use case refuses on its
   own (FR-021). An anonymous request never gets here: the endpoint's [Authorize] sends it to Sign in. *@
<PageTitle>Goals · Habit Tracker</PageTitle>

@if (_result is { } result)
{
    <div class="ht-container">
        <div class="ht-page-head"><h1>Goals</h1></div>
        @if (result.Goals.Count == 0)
        {
            <NoGoalsEmptyState />
        }
        else
        {
            <GoalsList Tab="@Tab" />
            <p class="ht-footnote">@ReportText.GoalsFootnote</p>
        }
    </div>
}

@code {
    private GoalListResult? _result;

    /// <summary>The selected tab from the address: "paused" for the Paused tab; any other value, or none, is Active.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await GoalService.ListAsync(await ActingUsers.GetAsync(), CancellationToken.None);
        if (result.Outcome != GoalListOutcome.Found)
        {
            Navigation.NotFound();
            return;
        }

        _result = result;
    }
}
