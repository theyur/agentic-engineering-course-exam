@page "/goals/{Id:guid}"
@attribute [Authorize]
@using HT.Application.Goals
@using HT.Domain.Goals
@using HT.Ui.Account
@using HT.Ui.Components.Records
@using Microsoft.AspNetCore.Authorization
@inject GoalService GoalService
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageGoalDetail, slice 5 state (HP-001, research R-12, contracts/host.md "Routes"): the static shell of
   the goal page. It looks the goal up: an administrator, an unknown goal and another account's goal all get the Not
   found page with 404 (slice 4 FR-020, FR-021), and the page title names no goal until the owner's goal is found. For
   the owner's goal it renders GoalDetailBody, the interactive, prerendered part, with the goal identifier only. *@
<PageTitle>@(_name ?? "Goal") · Habit Tracker</PageTitle>

@if (_name is not null)
{
    <div class="ht-container">
        <GoalDetailBody Id="Id" />
    </div>
}

@code {
    private string? _name;

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await GoalService.GetAsync(await ActingUsers.GetAsync(), new GoalId(Id), CancellationToken.None);
        if (result.Outcome != GoalReadOutcome.Found)
        {
            Navigation.NotFound();
            return;
        }

        _name = result.Goal!.Name;
    }
}
