@page "/admin"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using HT.Application.Habits
@using HT.Domain.Accounts
@using HT.Domain.Habits
@using HT.Ui.Account
@using HT.Ui.Habits
@using Microsoft.AspNetCore.Authorization
@inject UseCaseScope UseCases
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageAdmin, slice 4 state (US3-AS20, HP-009, HP-010, HP-008): the catalog only, so no Tabs and no
   "Updated" column. Publish and Unpublish act from the row and the row shows the new state at once. Unpublish of a
   habit that goals use gets "confirmation needed" from the use case and opens a Dialog with the use case's text (the
   number of goals only, ADR 0012); its "Unpublish" confirms, and Cancel, × and Esc change nothing and give the focus
   back to the row's button. A registered user gets the Not found page; the use cases refuse on their own (FR-014).
   Every use case runs in its own scope. *@
<PageTitle>Administration · Habit Tracker</PageTitle>

@if (_loaded)
{
    <div class="ht-container">
        <div class="ht-page-head">
            <h1>Administration</h1>
            <span class="ht-spacer"></span>
            <HtButton Href="/admin/catalog/new">+ New catalog habit</HtButton>
        </div>
        <div class="ht-stack">
            <Notice Neutral="true"><b>Privacy:</b> admins manage public content and accounts. Private goals, records, notes and personal reports are not available here.</Notice>
            <div>
                <div class="ht-results-bar">
                    <SearchField Id="admin-search" Label="Search catalog" Value="@_search" ValueChanged="OnSearchChangedAsync" />
                    <span class="ht-spacer"></span>
                    <span>Showing @_habits.Count of @_total</span>
                </div>
                <DataTable Columns="Columns" Label="Catalog habits">
                    @foreach (var habit in _habits)
                    {
                        <tr @key="habit.Id">
                            <td><b>@habit.Name</b></td>
                            <td>@habit.Category</td>
                            <td>@habit.Intent</td>
                            <td><Tag Text="@habit.State.ToString()" Strong="@(habit.State == CatalogHabitState.Published)" /></td>
                            <td class="ht-actions">
                                <HtButton Variant="HtButton.ButtonVariant.Ghost" Small="true" Href="@($"/admin/catalog/{habit.Id.Value}")" aria-label="@($"Edit {habit.Name}")">Edit</HtButton>
                                @* One button that changes its words, not two: the keyboard focus stays on it after the click. *@
                                @{ var published = habit.State == CatalogHabitState.Published; }
                                @* A plain button, not HtButton, so the Dialog can give the focus back to it. *@
                                <button type="button" class="@(published ? "ht-btn ht-btn--secondary ht-btn--sm" : "ht-btn ht-btn--primary ht-btn--sm")"
                                        @ref="_stateButtons[habit.Id]"
                                        aria-label="@(published ? $"Unpublish {habit.Name}" : $"Publish {habit.Name}")"
                                        @onclick="() => published ? UnpublishAsync(habit) : PublishAsync(habit.Id)">@(published ? "Unpublish" : "Publish")</button>
                            </td>
                        </tr>
                    }
                </DataTable>
            </div>
        </div>
        <HtDialog Open="@(_confirmation is not null)" OnClose="CancelUnpublish" ReturnFocus="ReturnFocus">
            <Title>Unpublish this habit?</Title>
            <Subtitle>@_confirmation?.Name · Published</Subtitle>
            <ChildContent>
                <p>@_confirmation?.Message</p>
                <p>The goals keep working for their owners. No new goal can be based on this habit until you publish it again.</p>
            </ChildContent>
            <Footer>
                <HtButton @onclick="ConfirmUnpublishAsync">Unpublish</HtButton>
                <HtButton Variant="HtButton.ButtonVariant.Secondary" @onclick="CancelUnpublish">Cancel</HtButton>
            </Footer>
        </HtDialog>
    </div>
}

@code {
    private const int SearchDelayMilliseconds = 300;
    private static readonly IReadOnlyList<string> Columns = ["Habit", "Category", "Intent", "Status", string.Empty];

    private ActingUser _actingUser = ActingUser.Anonymous;
    private IReadOnlyList<CatalogHabitListItem> _habits = [];
    private int _total;
    private string _search = string.Empty;
    private bool _loaded;
    private int _request;
    private CancellationTokenSource? _pendingSearch;

    // Each row's Publish/Unpublish button, for the focus after the Dialog; the habit whose Dialog was opened last.
    private readonly Dictionary<HabitId, ElementReference> _stateButtons = [];
    private HabitId? _focusAfterDialog;

    // The open unpublish confirmation: the habit and the use case's text; null when the Dialog is closed.
    private Confirmation? _confirmation;

    private ElementReference? ReturnFocus =>
        _focusAfterDialog is { } id && _stateButtons.TryGetValue(id, out var button) ? button : null;

    // The search the address last asked for, or that this page last wrote to it; null before the first load.
    private string? _appliedQuery;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    protected override async Task OnInitializedAsync() => _actingUser = await ActingUsers.GetAsync();

    /// <summary>
    /// The address is the source of the search: a link or Back that changes "q" while the page stays open loads that
    /// search. The page's own address update after a search changes nothing, so typing on is not undone.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var query = Query ?? string.Empty;
        if (query == _appliedQuery)
        {
            return;
        }

        _appliedQuery = query;
        CancelPendingSearch();
        _search = query;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var request = ++_request;
        var search = _search;
        var result = await UseCases.RunAsync<CatalogAdministrationService, CatalogHabitListResult>(
            (service, token) => service.ListAsync(_actingUser, search, token), CancellationToken.None);
        if (result.Outcome != CatalogHabitListOutcome.Found)
        {
            Navigation.NotFound();
            return;
        }

        if (request != _request)
        {
            return;
        }

        _habits = result.Habits;
        _total = result.Total;
        _loaded = true;
    }

    private async Task PublishAsync(HabitId id)
    {
        await UseCases.RunAsync<CatalogAdministrationService, CatalogHabitPublishResult>(
            (service, token) => service.PublishAsync(_actingUser, id, token), CancellationToken.None);
        await LoadAsync();
    }

    /// <summary>Unpublishes at once, or opens the Dialog when the use case needs confirmation (FR-033, HP-008).</summary>
    private async Task UnpublishAsync(CatalogHabitListItem habit)
    {
        var result = await UnpublishAsync(habit.Id, confirmed: false);
        if (result.Outcome == CatalogHabitUnpublishOutcome.ConfirmationNeeded)
        {
            _focusAfterDialog = habit.Id;
            _confirmation = new Confirmation(habit.Id, habit.Name, result.Message ?? string.Empty);
            return;
        }

        await LoadAsync();
    }

    private async Task ConfirmUnpublishAsync()
    {
        if (_confirmation is not { } confirmation)
        {
            return;
        }

        await UnpublishAsync(confirmation.Id, confirmed: true);
        _confirmation = null;
        await LoadAsync();
    }

    private void CancelUnpublish() => _confirmation = null;

    private Task<CatalogHabitUnpublishResult> UnpublishAsync(HabitId id, bool confirmed) =>
        UseCases.RunAsync<CatalogAdministrationService, CatalogHabitUnpublishResult>(
            (service, token) => service.UnpublishAsync(_actingUser, id, confirmed, token), CancellationToken.None);

    private async Task OnSearchChangedAsync(string text)
    {
        _search = text;
        _pendingSearch?.Cancel();
        _pendingSearch?.Dispose();
        var pending = _pendingSearch = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDelayMilliseconds, pending.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (ReferenceEquals(pending, _pendingSearch))
        {
            _pendingSearch = null;
            pending.Dispose();
        }

        await LoadAsync();
        var query = string.IsNullOrWhiteSpace(_search) ? null : _search;
        _appliedQuery = query ?? string.Empty;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("q", query), replace: true);
    }

    private void CancelPendingSearch()
    {
        _pendingSearch?.Cancel();
        _pendingSearch?.Dispose();
        _pendingSearch = null;
    }

    public void Dispose() => CancelPendingSearch();

    private sealed record Confirmation(HabitId Id, string Name, string Message);
}
