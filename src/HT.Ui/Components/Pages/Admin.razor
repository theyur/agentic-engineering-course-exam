@page "/admin"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using HT.Application.Habits
@using HT.Domain.Accounts
@using HT.Domain.Habits
@using HT.Ui.Account
@using HT.Ui.Habits
@using Microsoft.AspNetCore.Authorization
@inject UseCaseScope UseCases
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageAdmin, slice 2 state (US3-AS20, HP-009, HP-010): the catalog only, so no Tabs and no "Updated"
   column. Publish and Unpublish act from the row and the row shows the new state at once. A registered user gets
   the Not found page; the use cases refuse on their own (FR-014). Every use case runs in its own scope. *@
<PageTitle>Administration · Habit Tracker</PageTitle>

@if (_loaded)
{
    <div class="ht-container">
        <div class="ht-page-head">
            <h1>Administration</h1>
            <span class="ht-spacer"></span>
            <HtButton Href="/admin/catalog/new">+ New catalog habit</HtButton>
        </div>
        <div class="ht-stack">
            <Notice Neutral="true"><b>Privacy:</b> admins manage public content and accounts. Private goals, records, notes and personal reports are not available here.</Notice>
            <div>
                <div class="ht-results-bar">
                    <SearchField Id="admin-search" Label="Search catalog" Value="@_search" ValueChanged="OnSearchChangedAsync" />
                    <span class="ht-spacer"></span>
                    <span>Showing @_habits.Count of @_total</span>
                </div>
                <DataTable Columns="Columns" Label="Catalog habits">
                    @foreach (var habit in _habits)
                    {
                        <tr @key="habit.Id">
                            <td><b>@habit.Name</b></td>
                            <td>@habit.Category</td>
                            <td>@habit.Intent</td>
                            <td><Tag Text="@habit.State.ToString()" Strong="@(habit.State == CatalogHabitState.Published)" /></td>
                            <td class="ht-actions">
                                <HtButton Variant="HtButton.ButtonVariant.Ghost" Small="true" Href="@($"/admin/catalog/{habit.Id.Value}")" aria-label="@($"Edit {habit.Name}")">Edit</HtButton>
                                @if (habit.State == CatalogHabitState.Published)
                                {
                                    <HtButton Variant="HtButton.ButtonVariant.Secondary" Small="true" aria-label="@($"Unpublish {habit.Name}")" @onclick="() => UnpublishAsync(habit.Id)">Unpublish</HtButton>
                                }
                                else
                                {
                                    <HtButton Small="true" aria-label="@($"Publish {habit.Name}")" @onclick="() => PublishAsync(habit.Id)">Publish</HtButton>
                                }
                            </td>
                        </tr>
                    }
                </DataTable>
            </div>
        </div>
    </div>
}

@code {
    private const int SearchDelayMilliseconds = 300;
    private static readonly IReadOnlyList<string> Columns = ["Habit", "Category", "Intent", "Status", string.Empty];

    private ActingUser _actingUser = ActingUser.Anonymous;
    private IReadOnlyList<CatalogHabitListItem> _habits = [];
    private int _total;
    private string _search = string.Empty;
    private bool _loaded;
    private int _request;
    private CancellationTokenSource? _pendingSearch;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _actingUser = await ActingUsers.GetAsync();
        _search = Query ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var request = ++_request;
        var search = _search;
        var result = await UseCases.RunAsync<CatalogAdministrationService, CatalogHabitListResult>(
            (service, token) => service.ListAsync(_actingUser, search, token), CancellationToken.None);
        if (result.Outcome != CatalogHabitListOutcome.Found)
        {
            Navigation.NotFound();
            return;
        }

        if (request != _request)
        {
            return;
        }

        _habits = result.Habits;
        _total = result.Total;
        _loaded = true;
    }

    private async Task PublishAsync(HabitId id)
    {
        await UseCases.RunAsync<CatalogAdministrationService, CatalogHabitPublishResult>(
            (service, token) => service.PublishAsync(_actingUser, id, token), CancellationToken.None);
        await LoadAsync();
    }

    private async Task UnpublishAsync(HabitId id)
    {
        await UseCases.RunAsync<CatalogAdministrationService, CatalogHabitUnpublishResult>(
            (service, token) => service.UnpublishAsync(_actingUser, id, token), CancellationToken.None);
        await LoadAsync();
    }

    private async Task OnSearchChangedAsync(string text)
    {
        _search = text;
        _pendingSearch?.Cancel();
        _pendingSearch?.Dispose();
        var pending = _pendingSearch = new CancellationTokenSource();
        try
        {
            await Task.Delay(SearchDelayMilliseconds, pending.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (ReferenceEquals(pending, _pendingSearch))
        {
            _pendingSearch = null;
            pending.Dispose();
        }

        await LoadAsync();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("q", string.IsNullOrWhiteSpace(_search) ? null : _search), replace: true);
    }

    public void Dispose()
    {
        _pendingSearch?.Cancel();
        _pendingSearch?.Dispose();
    }
}
