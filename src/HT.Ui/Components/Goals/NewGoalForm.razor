@using System.Globalization
@using HT.Domain.Accounts
@using HT.Domain.Goals
@using HT.Domain.Habits
@using HT.Ui.Goals
@* design/pages/PageNewGoal, slice 4 state (HP-001, HP-002, HP-012): one Card form in sections (Habit with Change and
   the habit chooser; "Do you want to build or reduce it?"; "How do you measure it?", with slice 5's help line
   "You can record partial amounts; the target decides the result." (HP-005); Target for count and duration;
   "When?"; Start date and "Name (optional)"; "Create goal" and Cancel) beside the summary card. Only the controls of
   the chosen measurement and schedule are shown. "At least" becomes "At most" for Reduce, and the amount's lowest
   value follows (Build 1, Reduce 0). One refusal at a time sits under its field. The page decides what the actions
   and a chosen habit do. *@
<div class="ht-grid-2">
    <EditForm Model="Model" OnSubmit="OnSubmit" class="ht-card" FormName="new-goal" novalidate>
        <div class="ht-form-section">
            <h2 class="ht-form-section__title">Habit</h2>
            @if (Model.Habit is { } habit)
            {
                <div class="ht-inline">
                    @if (habit.Icon is { } icon)
                    {
                        <span class="ht-habit__glyph ht-habit__glyph--row"><HtIcon Name="@icon" Size="HtIcon.IconSize.Large" /></span>
                    }
                    <b>@habit.Name</b>
                    <Tag Text="@habit.Category.ToString()" />
                    @if (habit.Kind == HabitKind.Custom)
                    {
                        <Tag Text="Private" Strong="true" />
                    }
                    <span class="ht-spacer"></span>
                    <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-haspopup="dialog" aria-label="Change habit"
                            aria-describedby="@ErrorId(GoalField.Habit)" @ref="_habitButton" @onclick="OpenChooser">Change</button>
                </div>
            }
            else
            {
                <p class="ht-form-section__help">Choose the habit this goal is for.</p>
                <button type="button" class="ht-btn ht-btn--secondary" aria-haspopup="dialog"
                        aria-describedby="@ErrorId(GoalField.Habit)" @ref="_habitButton" @onclick="OpenChooser">Choose a habit</button>
            }
            @ErrorText(GoalField.Habit)
        </div>
        <div class="ht-form-section">
            <h2 class="ht-form-section__title">Do you want to build or reduce it?</h2>
            <p class="ht-form-section__help">Build: do it at least the target. Reduce: stay at or below a limit.</p>
            <SegmentedControl TValue="BuildOrReduce" Label="Build or reduce" Options="Sides" Value="Model.BuildOrReduce"
                              ValueChanged="v => Model.BuildOrReduce = v" DescribedBy="@ErrorId(GoalField.BuildOrReduce)" />
            @ErrorText(GoalField.BuildOrReduce)
        </div>
        <div class="ht-form-section">
            <h2 class="ht-form-section__title" id="new-goal-measure">How do you measure it?</h2>
            <p class="ht-form-section__help">You can record partial amounts; the target decides the result.</p>
            <ChoiceCard TValue="Measurement" Name="new-goal-measure" LabelledBy="new-goal-measure" Options="Measurements"
                        Value="Model.Measurement" ValueChanged="v => Model.Measurement = v" DescribedBy="@ErrorId(GoalField.Measurement)" />
            @ErrorText(GoalField.Measurement)
        </div>
        @if (Model.HasAmount)
        {
            <div class="ht-form-section">
                <h2 class="ht-form-section__title">Target</h2>
                <div class="ht-inline">
                    <span>@(Model.BuildOrReduce == BuildOrReduce.Reduce ? "At most" : "At least")</span>
                    <Stepper Id="new-goal-amount" Label="Amount" Value="Model.Amount" ValueChanged="v => Model.Amount = v"
                             Min="@(Model.BuildOrReduce == BuildOrReduce.Reduce ? 0 : 1)" Max="999"
                             Step="@(Model.Measurement == Measurement.Duration && Model.DurationUnit != DurationUnit.Hours ? 5 : 1)"
                             DescribedBy="@ErrorId(GoalField.Amount)" Invalid="@(Error?.For(GoalField.Amount) is not null)" />
                    @if (Model.Measurement == Measurement.Count)
                    {
                        <input class="ht-input ht-unit-input" id="new-goal-unit" value="@Model.CountUnit" placeholder="pages" aria-label="Unit"
                               aria-describedby="@ErrorId(GoalField.Unit)" aria-invalid="@(Error?.For(GoalField.Unit) is null ? null : "true")"
                               @onchange="e => Model.CountUnit = e.Value?.ToString()" />
                    }
                    else
                    {
                        <SegmentedControl TValue="DurationUnit" Label="Unit" Options="Units" Value="Model.DurationUnit"
                                          ValueChanged="v => Model.DurationUnit = v" DescribedBy="@ErrorId(GoalField.Unit)" />
                    }
                </div>
                @ErrorText(GoalField.Amount)
                @ErrorText(GoalField.Unit)
            </div>
        }
        <div class="ht-form-section">
            <h2 class="ht-form-section__title" id="new-goal-when">When?</h2>
            <ChoiceCard TValue="ScheduleKind" Name="new-goal-when" LabelledBy="new-goal-when" Options="Schedules"
                        Value="Model.ScheduleKind" ValueChanged="v => Model.ScheduleKind = v" DescribedBy="@ErrorId(GoalField.Schedule)" />
            @ErrorText(GoalField.Schedule)
            @if (Model.ScheduleKind == ScheduleKind.FixedDays)
            {
                <DayPicker Days="Model.Days" DaysChanged="d => Model.Days = d" DescribedBy="@ErrorId(GoalField.Days)" />
                @ErrorText(GoalField.Days)
                <p class="ht-form-section__note">Each selected day is one commitment.</p>
            }
            else if (Model.ScheduleKind == ScheduleKind.Times)
            {
                <div class="ht-inline">
                    <Stepper Id="new-goal-times" Label="Times" Value="Model.Times" ValueChanged="v => Model.Times = v" Min="1" Max="20"
                             Unit="@(Model.Times == 1 ? "time" : "times")"
                             DescribedBy="@ErrorId(GoalField.Times)" Invalid="@(Error?.For(GoalField.Times) is not null)" />
                    <SegmentedControl TValue="SchedulePeriod" Label="Period" Options="Periods" Value="Model.Period"
                                      ValueChanged="v => Model.Period = v" DescribedBy="@ErrorId(GoalField.Period)" />
                </div>
                @ErrorText(GoalField.Times)
                @ErrorText(GoalField.Period)
                @if (Model.Period is { } period)
                {
                    <p class="ht-form-section__note">@(period == SchedulePeriod.Day ? "Each day is evaluated as a whole." : "Each week, Monday to Sunday, is evaluated as a whole.")</p>
                }
            }
        </div>
        <div class="ht-form-section">
            <div class="ht-field-pair">
                <label class="ht-field">
                    <span class="ht-field__label">Start date</span>
                    <input class="ht-input" type="date" id="new-goal-start" value="@StartDateValue"
                           aria-describedby="@ErrorId(GoalField.StartDate)" aria-invalid="@(Error?.For(GoalField.StartDate) is null ? null : "true")"
                           @onchange="OnStartDateChanged" />
                    @ErrorText(GoalField.StartDate)
                </label>
                <label class="ht-field">
                    <span class="ht-field__label">Name <span class="ht-muted">(optional)</span></span>
                    <input class="ht-input" id="new-goal-name" value="@Model.Name"
                           aria-describedby="@ErrorId(GoalField.Name)" aria-invalid="@(Error?.For(GoalField.Name) is null ? null : "true")"
                           @onchange="e => Model.Name = e.Value?.ToString()" />
                    @ErrorText(GoalField.Name)
                </label>
            </div>
        </div>
        <div class="ht-form-actions">
            <HtButton Type="submit">Create goal</HtButton>
            <HtButton Variant="HtButton.ButtonVariant.Secondary" Href="@CancelHref">Cancel</HtButton>
        </div>
    </EditForm>
    <GoalSummaryCard Model="Model" />
</div>
<HabitChooser Open="_chooserOpen" ActingUser="ActingUser" OnChoose="ChooseAsync" OnClose="CloseChooser" FocusOnClose="FocusHabitButtonAsync" />

@code {
    private static readonly IReadOnlyList<(BuildOrReduce, string)> Sides = [(BuildOrReduce.Build, "Build"), (BuildOrReduce.Reduce, "Reduce")];

    private static readonly IReadOnlyList<(Measurement, string, string)> Measurements =
    [
        (Measurement.YesNo, "Yes / no", "Did it or not"),
        (Measurement.Count, "Count", "Times, pages, cups"),
        (Measurement.Duration, "Duration", "Minutes or hours"),
    ];

    private static readonly IReadOnlyList<(DurationUnit, string)> Units = [(DurationUnit.Minutes, "Minutes"), (DurationUnit.Hours, "Hours")];

    private static readonly IReadOnlyList<(ScheduleKind, string, string)> Schedules =
    [
        (ScheduleKind.FixedDays, "On fixed days", "For example Mon to Fri"),
        (ScheduleKind.Times, "A number of times", "For example 5 times a week"),
    ];

    private static readonly IReadOnlyList<(SchedulePeriod, string)> Periods = [(SchedulePeriod.Day, "Per day"), (SchedulePeriod.Week, "Per week")];

    private ElementReference _habitButton;
    private bool _chooserOpen;

    [Parameter, EditorRequired]
    public GoalFormModel Model { get; set; } = new();

    /// <summary>The refusal to show under its field.</summary>
    [Parameter]
    public GoalFormError? Error { get; set; }

    /// <summary>The acting user, for the habit chooser's custom habits.</summary>
    [Parameter, EditorRequired]
    public ActingUser ActingUser { get; set; } = ActingUser.Anonymous;

    /// <summary>Where Cancel goes: the page the user came from.</summary>
    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = "/goals";

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    /// <summary>A habit was chosen in the chooser; the page starts the form again from its starting values.</summary>
    [Parameter]
    public EventCallback<GoalHabit> OnHabitChosen { get; set; }

    private string? StartDateValue => Model.StartDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private void OnStartDateChanged(ChangeEventArgs e) =>
        Model.StartDate = DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : null;

    private void OpenChooser() => _chooserOpen = true;

    private void CloseChooser() => _chooserOpen = false;

    // The page restarts the form first, so the closing render already has the habit's "Change" button, and the
    // focus goes back to it.
    private async Task ChooseAsync(GoalHabit habit)
    {
        await OnHabitChosen.InvokeAsync(habit);
        _chooserOpen = false;
    }

    private ValueTask FocusHabitButtonAsync() => _habitButton.FocusAsync();

    private static string ErrorIdOf(GoalField field) => "new-goal-" + field + "-error";

    private string? ErrorId(GoalField field) => Error?.For(field) is null ? null : ErrorIdOf(field);

    private RenderFragment? ErrorText(GoalField field) => Error?.For(field) is { } message
        ? @<span class="ht-field__error" id="@ErrorIdOf(field)">@message</span>
        : null;
}
