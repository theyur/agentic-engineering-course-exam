@using HT.Application.Accounts
@using HT.Domain.Accounts
@inject AccountService AccountService
@* design/pages/PageProfile, slice 1: the "Change password" form of the Account card. A static SSR form (research
   R-08): a mismatch is checked here, before the use case; each refusal sits under its field; a change shows the
   notice, empties the fields and raises OnSucceeded, so the page can refresh the session (HP-014). *@
@if (_changed)
{
    <Notice Role="status">@PasswordChanged</Notice>
}
<EditForm Model="Input" method="post" FormName="change-password" OnSubmit="SubmitAsync" class="ht-form-section ht-stack" novalidate>
    <h3 class="ht-form-section__title">Change password</h3>
    <TextField Id="change-current-password"
               Label="Current password"
               Type="password"
               AutoComplete="current-password"
               Error="@_currentError"
               @bind-Value="Input.CurrentPassword" />
    <TextField Id="change-new-password"
               Label="New password"
               Type="password"
               AutoComplete="new-password"
               Help="@AccountTexts.PasswordRule"
               Error="@_newError"
               @bind-Value="Input.NewPassword" />
    <TextField Id="change-repeat-new-password"
               Label="Repeat new password"
               Type="password"
               AutoComplete="new-password"
               Error="@_repeatError"
               @bind-Value="Input.RepeatNewPassword" />
    <div><HtButton Type="submit">Change password</HtButton></div>
</EditForm>

@code {
    /// <summary>Shown next to the repeated new password when it differs; checked here, before the use case.</summary>
    public const string PasswordsDoNotMatch = "The passwords do not match.";

    /// <summary>The notice after a successful change (HP-014).</summary>
    public const string PasswordChanged = "Your password is changed.";

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput Input { get; set; } = default!;

    /// <summary>The signed-in user whose password the form changes (HP-014).</summary>
    [Parameter, EditorRequired]
    public ActingUser ActingUser { get; set; } = ActingUser.Anonymous;

    /// <summary>Raised once with the <see cref="PasswordChangeOutcome.Changed"/> result.</summary>
    [Parameter]
    public EventCallback<PasswordChangeResult> OnSucceeded { get; set; }

    private bool _changed;
    private string? _currentError;
    private string? _newError;
    private string? _repeatError;

    protected override void OnInitialized() => Input ??= new ChangePasswordInput();

    private async Task SubmitAsync()
    {
        _changed = false;
        _currentError = null;
        _newError = null;
        _repeatError = null;

        if (!string.Equals(Input.NewPassword, Input.RepeatNewPassword, StringComparison.Ordinal))
        {
            _repeatError = PasswordsDoNotMatch;
            ClearFields();
            return;
        }

        var result = await AccountService.ChangePasswordAsync(
            ActingUser, Input.CurrentPassword, Input.NewPassword, CancellationToken.None);
        switch (result.Outcome)
        {
            case PasswordChangeOutcome.Changed:
                _changed = true;
                ClearFields();
                await OnSucceeded.InvokeAsync(result);
                return;
            case PasswordChangeOutcome.PasswordRuleNotMet:
                _newError = result.Message;
                break;
            default:
                // CurrentPasswordWrong, and NotSignedIn for a session whose account is gone.
                _currentError = result.Message;
                break;
        }

        ClearFields();
    }

    private void ClearFields()
    {
        Input.CurrentPassword = null;
        Input.NewPassword = null;
        Input.RepeatNewPassword = null;
    }

    private sealed class ChangePasswordInput
    {
        public string? CurrentPassword { get; set; }

        public string? NewPassword { get; set; }

        public string? RepeatNewPassword { get; set; }
    }
}
