@rendermode InteractiveServer
@implements IDisposable
@using HT.Ui.Account
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@using HT.Domain.Accounts
@* design/components/TopNav and MobileNav, slice 2 (HP-011): "Catalog" for every audience and "Admin" for
   administrators; no links of later slices (ADR 0008). The only interactive component: it
   holds the state of the avatar menu and the narrow-screen menu. Each closes on Esc, on a click outside (the
   click-away layer) and on choosing an item, and focus goes back to its button. Opening one closes the other. *@
<div @onkeydown="OnKeyDownAsync">
    <header class="ht-nav">
        <div class="ht-nav__inner">
            <a class="ht-nav__brand" href="/">Habit Tracker</a>
            @if (_email is null)
            {
                <nav class="ht-nav__links" aria-label="Main">
                    <a href="/catalog" aria-current="@CatalogCurrent" @onclick="ChooseItemAsync">Catalog</a>
                </nav>
                <div class="ht-nav__end">
                    <a class="ht-btn ht-btn--ghost ht-hide-sm" href="/sign-in">Sign in</a>
                    <a class="ht-btn ht-btn--primary ht-btn--sm ht-hide-sm" href="/register">Register</a>
                    @MenuButton
                </div>
            }
            else
            {
                <nav class="ht-nav__links" aria-label="Main">
                    <a href="/" aria-current="@TodayCurrent" @onclick="ChooseItemAsync">Today</a>
                    <a href="/catalog" aria-current="@CatalogCurrent" @onclick="ChooseItemAsync">Catalog</a>
                    @if (_isAdministrator)
                    {
                        <a href="/admin" aria-current="@AdminCurrent" @onclick="ChooseItemAsync">Admin</a>
                    }
                </nav>
                <div class="ht-nav__end">
                    <div class="ht-account ht-layer-top">
                        <button type="button" class="ht-avatar ht-avatar-btn" id="@AccountButtonId"
                                aria-label="@("Account menu for " + _email)" aria-haspopup="true"
                                aria-expanded="@AriaBool(_open == Menu.Account)" aria-controls="@AccountMenuId"
                                @ref="_accountButton" @onclick="() => Toggle(Menu.Account)">@Avatar.LetterOf(_email)</button>
                        @if (_open == Menu.Account)
                        {
                            <div class="ht-popover" id="@AccountMenuId">
                                <a href="/profile" @onclick="ChooseItemAsync"><HtIcon Name="user" />Profile</a>
                                @SignOutForm
                            </div>
                        }
                    </div>
                    @MenuButton
                </div>
            }
        </div>
    </header>
    @if (_open == Menu.Mobile)
    {
        <nav class="ht-mobile-menu ht-layer-top" id="@MobileMenuId" aria-label="Menu">
            @if (_email is null)
            {
                <a href="/catalog" aria-current="@CatalogCurrent" @onclick="ChooseItemAsync"><HtIcon Name="layout-grid" />Catalog</a>
                <a href="/sign-in" @onclick="ChooseItemAsync">Sign in</a>
                <a href="/register" @onclick="ChooseItemAsync">Register</a>
            }
            else
            {
                <a href="/" aria-current="@TodayCurrent" @onclick="ChooseItemAsync"><HtIcon Name="list-checks" />Today</a>
                <a href="/catalog" aria-current="@CatalogCurrent" @onclick="ChooseItemAsync"><HtIcon Name="layout-grid" />Catalog</a>
                @if (_isAdministrator)
                {
                    <a href="/admin" aria-current="@AdminCurrent" @onclick="ChooseItemAsync"><HtIcon Name="shield" />Admin</a>
                }
                <hr />
                <a href="/profile" @onclick="ChooseItemAsync"><HtIcon Name="user" />Profile</a>
                @SignOutForm
            }
        </nav>
    }
    @if (_open != Menu.None)
    {
        @* The mobile menu's layer is hidden with the menu at the wide breakpoint, so a widened window stays clickable. *@
        <div class="@(_open == Menu.Mobile ? "ht-clickaway ht-clickaway--mobile" : "ht-clickaway")" aria-hidden="true" @onclick="CloseAsync"></div>
    }
</div>

@code {
    public const string AccountButtonId = "account-menu-button";
    public const string AccountMenuId = "account-menu";
    public const string MobileButtonId = "mobile-menu-button";
    public const string MobileMenuId = "mobile-menu";

    private enum Menu
    {
        None,
        Account,
        Mobile,
    }

    private Menu _open;
    private string? _email;
    private bool _isAdministrator;
    private ElementReference _accountButton;
    private ElementReference _mobileButton;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Above the click-away layer, like the account button, so "Close menu" itself takes the click.
    private RenderFragment MenuButton => @<button type="button" class="ht-nav__menu-btn ht-layer-top" id="@MobileButtonId"
                                                  aria-label="@(_open == Menu.Mobile ? "Close menu" : "Menu")"
                                                  aria-expanded="@AriaBool(_open == Menu.Mobile)" aria-controls="@MobileMenuId"
                                                  @ref="_mobileButton" @onclick="() => Toggle(Menu.Mobile)"><HtIcon Name="@(_open == Menu.Mobile ? "x" : "menu")" /></button>;

    // A form, never a link (HP-006); the browser posts it, so the cookie is ended in an HTTP response.
    private RenderFragment SignOutForm => @<form method="post" action="@SignOutEndpoint.Path"><AntiforgeryToken /><button type="submit"><HtIcon Name="log-out" />Sign out</button></form>;

    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];

    private string? TodayCurrent => CurrentPath.Length == 0 ? "page" : null;

    // The catalog pages: the public catalog, a habit's details, and "My custom habits" with the custom habit form.
    private string? CatalogCurrent => IsIn("catalog") || IsIn("custom-habits") ? "page" : null;

    // The Admin page and the administrator's catalog habit form.
    private string? AdminCurrent => IsIn("admin") ? "page" : null;

    private bool IsIn(string section)
    {
        var path = CurrentPath;
        return string.Equals(path, section, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(section + "/", StringComparison.OrdinalIgnoreCase);
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override async Task OnParametersSetAsync()
    {
        var wasSignedIn = _email is not null;
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        _email = user?.Identity?.IsAuthenticated == true ? user.Identity.Name ?? string.Empty : null;
        _isAdministrator = _email is not null && user!.IsInRole(nameof(Role.Administrator));

        // The circuit's revalidation ended the session while the page stays open, for example after a password
        // change in another browser (HP-007). The page body is rendered statically, so reload it: the new request
        // has no valid session, and Profile sends the browser to Sign in, Home shows the visitor Home.
        if (wasSignedIn && _email is null)
        {
            Navigation.Refresh(forceReload: true);
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private void Toggle(Menu menu) => _open = _open == menu ? Menu.None : menu;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task ChooseItemAsync() => CloseAsync();

    private async Task CloseAsync()
    {
        var closed = _open;
        _open = Menu.None;
        if (closed == Menu.Account)
        {
            await _accountButton.FocusAsync();
        }
        else if (closed == Menu.Mobile)
        {
            await _mobileButton.FocusAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _open = Menu.None;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
