@using System.Globalization
@using HT.Application.Records
@using HT.Domain.Evaluation
@using HT.Domain.Goals
@using HT.Domain.Records
@* design/pages/PageGoalDetail, slice 5 state amended by specs/006-note-editing (HP-001, US3-AS8, US5-AS5; 006 HP-001,
   HP-002; contracts/host.md "History card"): the goal page's History card. Its head (ht-card__head) has the title
   "History", ht-spacer and the muted sentence "Corrections are evaluated with the rules of that date." beside it; then a
   DataTable with Date, Recorded, Result, Note and the empty-headed actions column. The rows are the history's begun
   entries (Upcoming ones are not listed), newest first: the first 10, then "Show all N →", which shows the rest in
   place. Date and Recorded come from RecordingText (a commitment's record as text; a period's records side by side,
   ht-inline, each a button that opens "Edit" of that record; "—" without a record), Result is the StatusChip, and Note
   is the row's note as plain text, or "—", in ht-muted, never a control. The row actions, whatever the row's state,
   final included, in this order: "Add note" (no note) or "Edit note" (a note), then "Add record", on a commitment or
   period without a record; "Edit" on a commitment with a record; "Add record" on a period with 1 to 49 records; none on
   a period with 50. A row with a record changes its note only in the RecordDialog. The record control is always the
   last button of the actions cell, so it is the rightmost on every row (the owner's order, 2026-11-20). Every row
   control is a ghost small button with aria-haspopup="dialog" and an accessible name that starts with its visible text
   and names its row ("Add note for {date}", "Edit note of {date}").
   The card raises OnAction for a record and OnNote for a note; the page opens the RecordDialog or the NoteDialog and,
   when it closes, gives the focus back through FocusAsync or FocusNoteAsync. With no begun entry the card is not
   rendered.
   Slice 7 (HP-001, FR-017; design/pages/PageGoalDetail, slice 7 state): an Excused row shows its reason after the
   StatusChip (ht-muted, in an ht-inline group with it), keeps its note control, never has "Add record", and has the ghost
   "Remove excusal" ("Remove excusal of {date}", no aria-haspopup, as it acts at once) as its last control while
   CanRemoveExcusal. The card raises OnRemoveExcusal; the page removes the excusal, reads everything again and gives the
   focus to FocusRecordOrNoteAsync. A refusal the page passes as Refusal shows under the card head with role="alert".
   A Paused row (FR-009) has its StatusChip and its note control, never "Add record"; a commitment's record kept on it
   keeps its "Edit", and a period's kept records stay their own buttons.
   Slice 8 (research R-07, contracts/host.md "History card and dialogs"): each row reads its own settings through
   History.SettingsOf(entry), never the History's goal-level fields: its Recorded cell, its StatusChip and its record
   controls, so after a change of measurement 11 Nov reads "12 min" and 12 Nov "12 pages" (AC-020). *@
@if (_rows.Count > 0)
{
    <section class="ht-card">
        <div class="ht-card__head">
            <h2 class="ht-card__title">History</h2>
            <span class="ht-spacer"></span>
            <p class="ht-card__sub">Corrections are evaluated with the rules of that date.</p>
        </div>
        @if (Refusal is not null)
        {
            <p class="ht-field__error" role="alert">@Refusal</p>
        }
        <DataTable Columns="Columns" Label="History">
            @foreach (var entry in ShownRows)
            {
                var date = RecordingText.EntryDate(entry);
                var settings = History.SettingsOf(entry);
                <tr @key="entry.FirstDate">
                    <td><b>@date</b></td>
                    <td>
                        @if (entry.Records.Count == 0)
                        {
                            @NoRecord
                        }
                        else if (IsCommitment(settings))
                        {
                            @RecordingText.Recorded(settings, entry.Records[0])
                        }
                        else
                        {
                            <span class="ht-inline">
                                @for (var i = 0; i < entry.Records.Count; i++)
                                {
                                    var record = entry.Records[i];
                                    var text = RecordingText.Recorded(settings, record);
                                    var name = text + ", edit record " + (i + 1).ToString(CultureInfo.InvariantCulture) + " of " + date;
                                    <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-haspopup="dialog" aria-label="@name"
                                            @key="record.Id" @ref="_recordButtons[record.Id]"
                                            @onclick="() => OnAction.InvokeAsync(new RowAction(entry, record))">@text</button>
                                }
                            </span>
                        }
                    </td>
                    <td>
                        @if (entry.ExcusalReason is { } reason)
                        {
                            <span class="ht-inline"><StatusChip State="entry.State" ScheduleKind="settings.GoalScheduleKind" Period="settings.Period" /><span class="ht-muted">@reason</span></span>
                        }
                        else
                        {
                            <StatusChip State="entry.State" ScheduleKind="settings.GoalScheduleKind" Period="settings.Period" />
                        }
                    </td>
                    <td class="ht-muted">@(entry.Note ?? NoNote)</td>
                    <td class="ht-actions">
                        @* The note control comes first and the record control last, so the record control is always the
                           rightmost. Blazor matches elements by their place in this markup, not by their position in the
                           cell, so the record control keeps its element, and its element reference, when the note
                           control goes. *@
                        @if (HasNoteControl(entry))
                        {
                            var hasNote = entry.Note is not null;
                            <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-haspopup="dialog"
                                    aria-label="@(hasNote ? EditNote + " of " + date : AddNote + " for " + date)"
                                    @ref="_noteButtons[entry.FirstDate]"
                                    @onclick="() => OnNote.InvokeAsync(entry)">@(hasNote ? EditNote : AddNote)</button>
                        }
                        @if (entry.State == EvaluationState.Excused)
                        {
                            @* An Excused commitment never has a record (D-3) and takes none (FR-005): "Remove excusal" takes
                               the place of the record control while its grace period is open (design, settled in T003). It
                               acts at once, so it has no aria-haspopup. *@
                            if (entry.CanRemoveExcusal)
                            {
                                <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-label="@(RemoveExcusal + " of " + date)"
                                        @onclick="() => OnRemoveExcusal.InvokeAsync(entry)">@RemoveExcusal</button>
                            }
                        }
                        else if (IsCommitment(settings) && HasRecordControl(entry))
                        {
                            @* A Paused commitment takes no new record (FR-009), so it keeps only the "Edit" of a record kept on it. *@
                            var record = entry.Records.Count == 0 ? null : entry.Records[0];
                            <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-haspopup="dialog"
                                    aria-label="@(record is null ? AddRecord + " for " + date : "Edit record of " + date)"
                                    @ref="_actionButtons[entry.FirstDate]"
                                    @onclick="() => OnAction.InvokeAsync(new RowAction(entry, record))">@(record is null ? AddRecord : "Edit")</button>
                        }
                        else if (!IsCommitment(settings) && HasRecordControl(entry))
                        {
                            <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-haspopup="dialog" aria-label="@(AddRecord + " for " + date)"
                                    @ref="_actionButtons[entry.FirstDate]"
                                    @onclick="() => OnAction.InvokeAsync(new RowAction(entry, null))">@AddRecord</button>
                        }
                    </td>
                </tr>
            }
        </DataTable>
        @if (!_expanded && _rows.Count > FirstRows)
        {
            <button type="button" class="ht-btn ht-btn--ghost ht-btn--sm" aria-expanded="false" @onclick="ShowAll">Show all @_rows.Count.ToString(CultureInfo.InvariantCulture) →</button>
        }
    </section>
}

@code {
    /// <summary>How many rows the card shows before "Show all N →" (HP-001).</summary>
    private const int FirstRows = 10;

    /// <summary>The Recorded cell of an entry without a record.</summary>
    private const string NoRecord = "—";

    private const string AddRecord = "Add record";

    /// <summary>The Note cell of an entry without a note.</summary>
    private const string NoNote = "—";

    private const string AddNote = "Add note";

    private const string EditNote = "Edit note";

    private const string RemoveExcusal = "Remove excusal";

    private static readonly IReadOnlyList<string> Columns = ["Date", "Recorded", "Result", "Note", string.Empty];

    private readonly Dictionary<DateOnly, ElementReference> _actionButtons = [];
    private readonly Dictionary<RecordId, ElementReference> _recordButtons = [];
    private readonly Dictionary<DateOnly, ElementReference> _noteButtons = [];
    private List<HistoryEntry> _rows = [];
    private bool _expanded;

    /// <summary>The goal's history from <c>GetHistoryAsync</c>, its entries in date order.</summary>
    [Parameter, EditorRequired]
    public GoalHistory History { get; set; } = default!;

    /// <summary>A row action or a period's record was chosen: the row, and the record for "Edit" (null for "Add record").</summary>
    [Parameter]
    public EventCallback<RowAction> OnAction { get; set; }

    /// <summary>The "Add note" or "Edit note" of a row without a record was chosen: the row whose note the NoteDialog opens for.</summary>
    [Parameter]
    public EventCallback<HistoryEntry> OnNote { get; set; }

    /// <summary>
    /// The "Remove excusal" of an Excused row was chosen (slice 7 HP-001, FR-004): the row whose excusal the page removes
    /// through <c>RemoveExcusalAsync</c>, then reads everything again.
    /// </summary>
    [Parameter]
    public EventCallback<HistoryEntry> OnRemoveExcusal { get; set; }

    /// <summary>
    /// A refusal of "Remove excusal" ("This excusal can no longer be removed."), shown under the card head as an alert;
    /// null for none (design/pages/PageGoalDetail, slice 7 state).
    /// </summary>
    [Parameter]
    public string? Refusal { get; set; }

    /// <summary>Whether the card is rendered for <paramref name="history"/>: it has at least one begun entry.</summary>
    public static bool HasRows(GoalHistory? history) => history is not null && RowsOf(history).Any();

    /// <summary>
    /// Gives the focus back to the control that opened a dialog for <paramref name="row"/>, as the card shows it now:
    /// the button of <paramref name="record"/> while the row still shows it, otherwise the row's action; nothing when the
    /// row shows neither (constitution IV).
    /// </summary>
    public ValueTask FocusAsync(DateOnly row, RecordId? record)
    {
        if (ShownRows.FirstOrDefault(e => e.FirstDate == row) is not { } entry)
        {
            return ValueTask.CompletedTask;
        }

        if (!IsCommitment(entry) && record is { } id && entry.Records.Any(r => r.Id == id) && _recordButtons.TryGetValue(id, out var recordButton))
        {
            return recordButton.FocusAsync();
        }

        return HasRecordControl(entry) && _actionButtons.TryGetValue(row, out var action)
            ? action.FocusAsync()
            : ValueTask.CompletedTask;
    }

    /// <summary>
    /// After "Remove excusal" of <paramref name="row"/> and the page's re-read: the focus goes to the row's "Add record",
    /// or, when the row has none (a pause covers it), to its note control (design/pages/PageGoalDetail, slice 7 state).
    /// </summary>
    public ValueTask FocusRecordOrNoteAsync(DateOnly row) =>
        ShownRows.FirstOrDefault(entry => entry.FirstDate == row) is { } shown && HasRecordControl(shown)
            ? FocusAsync(row, null)
            : FocusNoteAsync(row);

    /// <summary>
    /// Gives the focus back to the note control of <paramref name="row"/>, as the card shows it now ("Add note" or "Edit
    /// note", which a save may have swapped); nothing when the row is not shown or has no note control, as a row with a
    /// record has none (constitution IV, HP-004).
    /// </summary>
    public ValueTask FocusNoteAsync(DateOnly row) =>
        ShownRows.FirstOrDefault(entry => entry.FirstDate == row) is { } shown && HasNoteControl(shown)
            && _noteButtons.TryGetValue(row, out var button)
            ? button.FocusAsync()
            : ValueTask.CompletedTask;

    protected override void OnParametersSet() => _rows = RowsOf(History).ToList();

    /// <summary>
    /// Whether <paramref name="entry"/> is a commitment, by its own settings (slice 8, research R-07): the Recorded cell,
    /// the record controls and the focus follow the row's schedule kind, never the History's goal-level one.
    /// </summary>
    private bool IsCommitment(HistoryEntry entry) => IsCommitment(History.SettingsOf(entry));

    private static bool IsCommitment(EntrySettings settings) => settings.GoalScheduleKind == GoalScheduleKind.CommitmentBased;

    private IEnumerable<HistoryEntry> ShownRows => _expanded ? _rows : _rows.Take(FirstRows);

    /// <summary>A period takes another record while it has fewer than 50 (HP-001, FR-005).</summary>
    private static bool TakesRecord(HistoryEntry entry) => entry.Records.Count < RecordLimits.MaxRecordsPerPeriod;

    /// <summary>
    /// Whether the row has a record control ("Add record" or "Edit"): not an Excused row, which takes no record (slice 7
    /// FR-005); on a Paused row only the "Edit" of a commitment's kept record, as a Paused commitment or period takes no
    /// new record and a period's kept records stay their own buttons (slice 7 FR-009); otherwise a commitment always, a
    /// period while it takes another record.
    /// </summary>
    private bool HasRecordControl(HistoryEntry entry) => entry.State switch
    {
        EvaluationState.Excused => false,
        EvaluationState.Paused => IsCommitment(entry) && entry.Records.Count > 0,
        _ => IsCommitment(entry) || TakesRecord(entry),
    };

    /// <summary>
    /// Only a row without a record changes its note on its own; a row with a record changes it in the RecordDialog
    /// (specs/006-note-editing HP-002).
    /// </summary>
    private static bool HasNoteControl(HistoryEntry entry) => entry.Records.Count == 0;

    /// <summary>The begun entries, newest first; Upcoming ones have no row.</summary>
    private static IEnumerable<HistoryEntry> RowsOf(GoalHistory history) =>
        history.Entries
            .Where(entry => entry.State != EvaluationState.Upcoming)
            .OrderByDescending(entry => entry.FirstDate);

    private void ShowAll() => _expanded = true;

    /// <summary>What a row control asks for: "Add record" for <see cref="Entry"/>, or "Edit" of <see cref="Record"/>.</summary>
    public sealed record RowAction(HistoryEntry Entry, RecordView? Record);
}
