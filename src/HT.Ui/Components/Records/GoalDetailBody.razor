@rendermode InteractiveServer
@using HT.Application.Goals
@using HT.Application.Records
@using HT.Application.Reports
@using HT.Domain.Accounts
@using HT.Domain.Evaluation
@using HT.Domain.Exemptions
@using HT.Domain.Goals
@using HT.Application.Exemptions
@using HT.Ui.Account
@using HT.Ui.Components.Exemptions
@using HT.Ui.Components.Goals
@using HT.Ui.Habits
@inject UseCaseScope UseCases
@inject ActingUserAccessor ActingUsers
@inject NavigationManager Navigation
@* design/pages/PageGoalDetail, slice 5 state with slice 6's GoalStats and TrendChart cards (HP-001, research R-12,
   contracts/host.md "Goal page"): the interactive part of the goal page, prerendered, with the goal identifier as its
   only parameter. Slice 4's head ("← Goals", the name, the tags and the attempt line), with the primary action "Record"
   when something can be recorded now (FR-011) and no other action; slice 4's Notice for a habit no longer in the
   catalog; then the page's two columns: on the left the GoalStats card ("This attempt", "Consistency and streaks", with
   the strip of the latest 30 ended results), then the TrendChart card of the report's trend, both shown only when the
   goal's report has a begun entry, above the History card; on the right
   the Settings card, then the Recent notes card (US4). The history is read after what can be recorded now, from 365
   days before that result's current date D to D, and the goal's report (slice 6 FR-007) after the history. A goal
   with no current date, or with no begun entry, shows no History card and has the design's layout for that case: the
   Settings card alone in ht-grid-2. A goal with no current date shows no "Record". "Record" opens the RecordDialog
   with what can be recorded now; a History row's "Add record", "Edit" or record button opens it for that row or
   record, with the history's settings (US3, HP-001). "Add note" or "Edit note" of a row without a record opens the
   NoteDialog for that row (US4, HP-003; specs/006-note-editing HP-002, HP-004). The recent notes are read after the
   report, and only for a goal with a current date. After a save or a delete, what can be recorded, the history, the
   report and the recent notes are read again before the dialog closes, so the closing render already has the new rows,
   figures and notes, and the focus goes back to the head's "Record" or to the row's control as the card now shows it.
   Slice 7 (HP-001, HP-003, FR-024; contracts/host.md "Goal page"): the RecordDialog's "Excuse instead" opens the Excuse
   dialog for that commitment in its place, with the RecordDialog's opener as its own; a History row's "Remove excusal"
   calls RemoveExcusalAsync and shows a refusal under the History card head. After "excused" and after a removal (or its
   refusal) everything is read again, so the History, GoalStats and trend agree without a reload; the focus goes back
   to the opener, or to the row's "Add record" or note control.
   Slice 7 pauses (HP-001, HP-002, FR-009 to FR-012, US2-AS14): the goal's pauses are read first, with the pause date
   (research R-03), for every goal. The head has the secondary "Pause" (aria-haspopup="dialog") before "Record", both in an
   ht-inline group, while no pause is current; it opens the PauseDialog, whose "From" starts on the pause date. While a
   pause is current, the Notice "Paused until {last day} · Resume now" sits under the head, before slice 4's catalog
   Notice; its "Resume now" resumes the goal, and a refusal shows in its place. The Pauses card follows Settings in the
   right column (in the Settings column of a goal with no begun entry), with "Resume now" and "Cancel pause"; their
   refusals show under its title. After any of these the page reads everything again, and the focus goes to "Pause", or,
   when a current pause removed it, to the Notice's "Resume now".
   Slice 8 (HP-001, design/pages/PageGoalDetail "Slice 8 state"): the head of a goal that is not ended always has its
   actions in one ht-inline group after ht-spacer, the ghost link "Edit settings" (to /goals/{id}/edit) first, then
   "Pause" and "Record" as above, whatever the goal's state (paused or not started included).
   Slice 8 US2 (HP-001, HP-003, HP-009): the ghost "End goal" (aria-haspopup="dialog") follows "Pause" and comes before
   "Record", and opens the EndGoalDialog. The attempt line comes from ReportText and GoalDetails.AttemptHasBegun ("started",
   "starts", or "ended before it began" for an ended latest attempt that never began). An ended goal has no head actions
   and no ht-spacer; directly under the head it has the Notice "Ended Mon 16 Nov · Abandoned" with the link "Start new
   attempt" (/goals/{id}/new-attempt), and never the paused Notice; its History card keeps its record and note actions.
   After "goal ended" the page reads the goal and everything else again, and the focus goes to the Notice's "Start new
   attempt"; after Esc, × or Cancel it goes back to "End goal".
   Slice 8 US3 (HP-001): the goal's attempts are read with the pauses, on every read, and the Earlier attempts card
   follows Recent notes in the right column; for a goal with no begun entry it follows Settings (and Pauses) in the
   Settings column. It is absent when the goal has no earlier attempt.
   Every use case runs in its own scope. *@
@if (_goal is { } goal)
{
    <BackLink Href="/goals" Text="Goals" />
    <div class="ht-page-head ht-detail-head">
        <div>
            <h1>@goal.Name</h1>
            <div class="ht-inline ht-head-tags">
                <Tag Text="@goal.Habit.Category.ToString()" />
                <Tag Text="@goal.BuildOrReduce.ToString()" />
                <Tag Text="@(goal.GoalScheduleKind == GoalScheduleKind.CommitmentBased ? "Commitment-based" : "Period-based")" />
                <span class="ht-attempt">@AttemptLine(goal)</span>
            </div>
        </div>
        @if (!goal.IsEnded)
        {
            <span class="ht-spacer"></span>
            <div class="ht-inline">
                <a class="ht-btn ht-btn--ghost" href="@($"/goals/{Id}/edit")">Edit settings</a>
                @if (CanPause)
                {
                    <button type="button" class="ht-btn ht-btn--secondary" aria-haspopup="dialog" @ref="_pauseButton" @onclick="OpenPause">Pause</button>
                }
                <button type="button" class="ht-btn ht-btn--ghost" aria-haspopup="dialog" @ref="_endButton" @onclick="OpenEnd">End goal</button>
                @if (CanRecord)
                {
                    <button type="button" class="ht-btn ht-btn--primary" aria-haspopup="dialog" @ref="_recordButton" @onclick="OpenRecord">Record</button>
                }
            </div>
        }
    </div>
    @if (goal is { IsEnded: true, EndingDate: { } endingDate, Outcome: { } outcome })
    {
        <div class="ht-notice">
            <span>@ReportText.Ended(endingDate, outcome)</span>
            <span aria-hidden="true">·</span>
            <a class="ht-btn ht-btn--primary ht-btn--sm" href="@($"/goals/{Id}/new-attempt")" @ref="_startNewAttemptLink">Start new attempt</a>
        </div>
    }
    @if (_resumeRefusal is { } resumeRefusal)
    {
        <p class="ht-field__error" role="alert">@resumeRefusal</p>
    }
    else if (!goal.IsEnded && CurrentPause is { } current)
    {
        <div class="ht-notice">
            <span>@ReportText.PausedUntil(current.LastDay)</span>
            <span aria-hidden="true">·</span>
            <button type="button" class="ht-btn ht-btn--primary ht-btn--sm" @ref="_noticeResumeButton" @onclick="ResumeFromNoticeAsync">Resume now</button>
        </div>
    }
    @if (goal.Habit.IsInCatalog == false)
    {
        <Notice Neutral="true">This habit is no longer in the public catalog. Your goal keeps working.</Notice>
    }
    @if (HistoryCard.HasRows(_history))
    {
        <div class="ht-grid-2">
            <div class="ht-stack">
                @if (_report is { HasBegunEntry: true } report)
                {
                    <GoalStats View="report.Stats" Strip="StripOf(report)" Unit="report.Stats.Unit" Eyebrow="This attempt" Title="Consistency and streaks" />
                    <TrendChart Trend="report.Trend" />
                }
                <HistoryCard @ref="_historyCard" History="_history!" OnAction="OpenRow" OnNote="OpenNote"
                             OnRemoveExcusal="RemoveExcusalAsync" Refusal="@_removeRefusal" />
            </div>
            <div class="ht-stack">
                <GoalSettingsCard Details="goal" />
                <PausesCard Pauses="_pauses" OnResume="ResumeFromCardAsync" OnCancel="CancelPauseAsync" Refusal="@_pausesRefusal" />
                <RecentNotesCard Notes="_recentNotes" ScheduleKind="_history!.GoalScheduleKind" Period="_history.Period" />
                <EarlierAttemptsCard Attempts="_attempts" GoalId="Id" GoalName="@goal.Name" />
            </div>
        </div>
    }
    else if (_pauses.Count > 0 || EarlierAttemptsCard.HasEarlier(_attempts))
    {
        @* A goal with no begun entry keeps the Settings card in ht-grid-2; with a pause, the Pauses card follows it in the
           same column (design/pages/PageGoalDetail, slice 7 state, settled in T003), and so does the Earlier attempts
           card (slice 8 state: a restarted goal whose new attempt has not begun). *@
        <div class="ht-grid-2">
            <div class="ht-stack">
                <GoalSettingsCard Details="goal" />
                <PausesCard Pauses="_pauses" OnResume="ResumeFromCardAsync" OnCancel="CancelPauseAsync" Refusal="@_pausesRefusal" />
                <EarlierAttemptsCard Attempts="_attempts" GoalId="Id" GoalName="@goal.Name" />
            </div>
        </div>
    }
    else
    {
        <div class="ht-grid-2">
            <GoalSettingsCard Details="goal" />
        </div>
    }
    @if (DialogHistory is { } dialogHistory)
    {
        <RecordDialog Open="_recordOpen" OnClose="CloseRecord" ReturnFocus="_recordButton" FocusOnClose="@(_row is null ? null : FocusRowAsync)"
                      GoalId="goal.Id" GoalName="@goal.Name" Recordable="dialogHistory" Row="_row" Editing="_editing"
                      ActingUser="_actingUser" OnSaved="SavedAsync" OnExcuseInstead="OpenExcuse" />
    }
    @if (_excuseEntry is { } excuseEntry)
    {
        <ExcuseDialog Open="_excuseOpen" OnClose="CloseExcuse" FocusOnClose="FocusAfterExcuseAsync" GoalId="goal.Id" Date="excuseEntry.FirstDate"
                      GoalName="@goal.Name" SubLine="@_excuseSubLine" ActingUser="_actingUser" OnSaved="ExcusedAsync" />
    }
    @if (_noteRow is { } noteRow && _history is { } history)
    {
        <NoteDialog Open="_noteOpen" OnClose="CloseNote" FocusOnClose="FocusNoteRowAsync" GoalId="goal.Id" GoalName="@goal.Name"
                    History="history" Row="noteRow" ActingUser="_actingUser" OnSaved="NoteSavedAsync" />
    }
    <EndGoalDialog Open="_endOpen" OnClose="CloseEnd" FocusOnClose="FocusEndOrStartAsync" GoalId="goal.Id" GoalName="@goal.Name"
                   SubLine="@AttemptLine(goal)" ActingUser="_actingUser" OnSaved="EndedAsync" />
    @if (_pauseDate is { } pauseDate)
    {
        <PauseDialog Open="_pauseOpen" OnClose="ClosePause" FocusOnClose="FocusPauseOrResumeAsync" GoalId="goal.Id" GoalName="@goal.Name"
                     Today="pauseDate" ActingUser="_actingUser" OnSaved="PausedAsync" />
    }
}

@code {
    /// <summary>How many days, up to the goal's current date, the History card covers (HP-001).</summary>
    private const int HistoryDays = 366;

    private ActingUser _actingUser = ActingUser.Anonymous;
    private GoalDetails? _goal;
    private GoalHistory? _recordable;
    private GoalHistory? _history;
    private bool _recordOpen;
    private ElementReference _recordButton;
    private HistoryCard? _historyCard;
    private IReadOnlyList<RecentNote> _recentNotes = [];
    private GoalReport? _report;
    private bool _noteOpen;

    /// <summary>The History row the NoteDialog was opened for; kept after it closes, so the focus can go back to it.</summary>
    private HistoryEntry? _noteRow;

    /// <summary>The History row the RecordDialog was opened from; null when "Record" opened it.</summary>
    private HistoryEntry? _row;

    /// <summary>The record of <see cref="_row"/> that "Edit" opened; null for "Add record" and for "Record".</summary>
    private RecordView? _editing;

    /// <summary>The commitment "Excuse instead" opened the Excuse dialog for; kept after it closes, so the focus can go back.</summary>
    private HistoryEntry? _excuseEntry;

    /// <summary>The History row whose RecordDialog "Excuse instead" replaced; null when the head's "Record" opened it.</summary>
    private HistoryEntry? _excuseRow;

    private bool _excuseOpen;
    private string _excuseSubLine = string.Empty;

    /// <summary>A refusal of a History row's "Remove excusal", shown under the History card head; null for none.</summary>
    private string? _removeRefusal;

    /// <summary>The History row whose control gets the focus after the next render ("Remove excusal" and its re-read).</summary>
    private DateOnly? _focusRowAfterRender;

    /// <summary>The goal's pauses, the latest first day first (slice 7 FR-012); empty until read.</summary>
    private IReadOnlyList<PauseView> _pauses = [];

    /// <summary>The pause date of the last pauses read (research R-03): the PauseDialog's "From" default and min.</summary>
    private DateOnly? _pauseDate;

    private bool _pauseOpen;
    private ElementReference _pauseButton;
    private ElementReference _noticeResumeButton;

    /// <summary>A refusal of the Notice's "Resume now", shown in the Notice's place; null for none.</summary>
    private string? _resumeRefusal;

    /// <summary>A refusal of the Pauses card's "Resume now" or "Cancel pause", shown under its title; null for none.</summary>
    private string? _pausesRefusal;

    /// <summary>Whether the head's "Pause", or else the Notice's "Resume now", gets the focus after the next render.</summary>
    private bool _focusPauseAfterRender;

    private bool _endOpen;
    private ElementReference _endButton;

    /// <summary>The ended Notice's "Start new attempt"; the focus goes there after an ending removed "End goal" (HP-009).</summary>
    private ElementReference _startNewAttemptLink;

    /// <summary>The goal's attempts, the latest first (slice 8 FR-014), for the Earlier attempts card; empty until read.</summary>
    private IReadOnlyList<AttemptView> _attempts = [];

    /// <summary>The goal's identifier; the page shell has already found it among the acting user's goals.</summary>
    [Parameter]
    public Guid Id { get; set; }

    /// <summary>"Record" is offered only when something can be recorded now (FR-011, HP-002).</summary>
    private bool CanRecord => _recordable is { Entries.Count: > 0 };

    /// <summary>The pause that is current at the pause date, which makes the goal paused (FR-018); null for none.</summary>
    private PauseView? CurrentPause => _pauses.FirstOrDefault(pause => pause.Timing == PauseTiming.Current);

    /// <summary>"Pause" is offered once the pauses are read, while no pause is current (HP-001).</summary>
    private bool CanPause => _pauseDate is not null && CurrentPause is null;

    protected override async Task OnInitializedAsync()
    {
        _actingUser = await ActingUsers.GetAsync();
        if (!await ReadGoalAsync())
        {
            Navigation.NotFound();
            return;
        }

        await ReadRecordsAsync();
    }

    /// <summary>The goal's details (slice 4 FR-020, slice 8 FR-017); false when the acting user has no such goal.</summary>
    private async Task<bool> ReadGoalAsync()
    {
        var read = await UseCases.RunAsync<GoalService, GoalReadResult>(
            (service, token) => service.GetAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        if (read.Goal is not { } goal)
        {
            return false;
        }

        _goal = goal;
        return true;
    }

    private void OpenEnd() => _endOpen = true;

    private void CloseEnd() => _endOpen = false;

    /// <summary>
    /// "goal ended" (slice 8 FR-007, HP-001): reads everything again first, the goal's details included, so the closing
    /// render has the ended Notice, no head actions and the ended attempt's cards; the dialog then gives the focus back
    /// through <see cref="FocusEndOrStartAsync"/>. A goal that is gone after the ending keeps the last details read.
    /// </summary>
    private async Task EndedAsync()
    {
        await ReadGoalAsync();
        await ReadRecordsAsync();
        _removeRefusal = null;
        _endOpen = false;
    }

    /// <summary>
    /// Gives the focus to the head's "End goal" while the page shows it; otherwise, as the ending removed it, to the
    /// nearest remaining control, the ended Notice's "Start new attempt" (HP-009).
    /// </summary>
    private ValueTask FocusEndOrStartAsync() =>
        _goal is { IsEnded: true } ? _startNewAttemptLink.FocusAsync() : _endButton.FocusAsync();

    /// <summary>
    /// What can be recorded now, then, with its current date D, the history of D − 365 to D (366 days; research R-12),
    /// then the goal's report (slice 6 FR-007), then the recent notes (FR-008). A goal with no current date has no
    /// history, no report and no notes to show.
    /// </summary>
    private async Task ReadRecordsAsync()
    {
        var pauses = await UseCases.RunAsync<PauseService, PausesResult>(
            (service, token) => service.GetPausesAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        _pauses = pauses.Pauses;
        _pauseDate = pauses.PauseDate;
        _resumeRefusal = null;
        _pausesRefusal = null;
        var attempts = await UseCases.RunAsync<AttemptService, AttemptListResult>(
            (service, token) => service.GetAttemptsAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        _attempts = attempts.Attempts;
        var recordable = await UseCases.RunAsync<RecordingService, RecordableResult>(
            (service, token) => service.GetRecordableAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        _recordable = recordable.History;
        if (_recordable?.CurrentDate is not { } current)
        {
            _history = null;
            _report = null;
            _recentNotes = [];
            return;
        }

        var history = await UseCases.RunAsync<RecordingService, HistoryResult>(
            (service, token) => service.GetHistoryAsync(_actingUser, new GoalId(Id), current.AddDays(-HistoryDays + 1), current, token),
            CancellationToken.None);
        _history = history.History;
        var report = await UseCases.RunAsync<ReportService, GoalReportResult>(
            (service, token) => service.GetGoalReportAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        _report = report.Report;
        var notes = await UseCases.RunAsync<RecordingService, RecentNotesResult>(
            (service, token) => service.GetRecentNotesAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        _recentNotes = notes.Notes;
    }

    /// <summary>
    /// The settings and entries the RecordDialog works with: what can be recorded now when "Record" opened it, the
    /// history when a History row did; none while neither is there to open it.
    /// </summary>
    private GoalHistory? DialogHistory => _row is null ? (CanRecord ? _recordable : null) : _history;

    private void OpenRecord()
    {
        _row = null;
        _editing = null;
        _recordOpen = true;
    }

    private void OpenRow(HistoryCard.RowAction action)
    {
        _row = action.Entry;
        _editing = action.Record;
        _recordOpen = true;
    }

    private void CloseRecord() => _recordOpen = false;

    /// <summary>Reads again first, so the render that closes the dialog has the new rows to give the focus back to.</summary>
    private async Task SavedAsync(HistoryEntry entry)
    {
        await ReadRecordsAsync();
        _removeRefusal = null;
        _recordOpen = false;
    }

    /// <summary>
    /// The RecordDialog's "Excuse instead" (slice 7 HP-003): the Excuse dialog opens for the commitment "For" names, in
    /// the RecordDialog's place, and its opener is the control that opened the RecordDialog. The sub line is that
    /// commitment's "For" label, at the instant the dialog's entries were read.
    /// </summary>
    private void OpenExcuse(HistoryEntry entry)
    {
        var read = DialogHistory ?? _recordable!;
        _excuseEntry = entry;
        _excuseRow = _row;
        _excuseSubLine = RecordingText.ForLabel(entry, read.CurrentDate ?? entry.LastDate, read.ReadAt);
        _recordOpen = false;
        _excuseOpen = true;
    }

    private void CloseExcuse() => _excuseOpen = false;

    /// <summary>"excused": reads everything again first, so the closing render has the Excused row and the new figures (FR-024).</summary>
    private async Task ExcusedAsync()
    {
        await ReadRecordsAsync();
        _removeRefusal = null;
        _excuseOpen = false;
    }

    /// <summary>
    /// Gives the focus back after the Excuse dialog closes (HP-007): to the opener, the head's "Record" or the row's
    /// "Add record", while the page still shows it; otherwise to the nearest remaining control, the row's note control
    /// (an excused row has no "Add record").
    /// </summary>
    private ValueTask FocusAfterExcuseAsync()
    {
        if (_excuseRow is null && CanRecord)
        {
            return _recordButton.FocusAsync();
        }

        return (_excuseRow ?? _excuseEntry) is { } row && _historyCard is { } card
            ? card.FocusRecordOrNoteAsync(row.FirstDate)
            : ValueTask.CompletedTask;
    }

    /// <summary>
    /// A History row's "Remove excusal" (slice 7 FR-004, HP-001): removes the excusal, then reads everything again, also
    /// after a refusal, which shows under the History card head; the focus then goes to the row's "Add record", or to its
    /// note control when it has none.
    /// </summary>
    private async Task RemoveExcusalAsync(HistoryEntry row)
    {
        var date = row.FirstDate;
        var result = await UseCases.RunAsync<ExcusalService, RemoveExcusalResult>(
            (service, token) => service.RemoveExcusalAsync(_actingUser, new GoalId(Id), date, token), CancellationToken.None);
        await ReadRecordsAsync();
        _removeRefusal = result.Outcome == RemoveExcusalOutcome.Removed ? null : result.Message;
        _focusRowAfterRender = date;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRowAfterRender is { } row)
        {
            _focusRowAfterRender = null;
            if (_historyCard is { } card)
            {
                await card.FocusRecordOrNoteAsync(row);
            }
        }

        if (_focusPauseAfterRender)
        {
            _focusPauseAfterRender = false;
            await FocusPauseOrResumeAsync();
        }
    }

    private void OpenPause() => _pauseOpen = true;

    private void ClosePause() => _pauseOpen = false;

    /// <summary>
    /// "paused" (slice 7 FR-006, US2-AS14): reads everything again first, so the closing render has the Notice, the Pauses
    /// card and the new figures; the dialog then gives the focus back through <see cref="FocusPauseOrResumeAsync"/>.
    /// </summary>
    private async Task PausedAsync()
    {
        await ReadRecordsAsync();
        _removeRefusal = null;
        _pauseOpen = false;
    }

    /// <summary>
    /// Gives the focus to the head's "Pause" while the page shows it; otherwise, as a re-read removed it (a pause is
    /// current), to the nearest remaining control, the Notice's "Resume now" (HP-007).
    /// </summary>
    private ValueTask FocusPauseOrResumeAsync()
    {
        if (CanPause)
        {
            return _pauseButton.FocusAsync();
        }

        return CurrentPause is not null && _resumeRefusal is null ? _noticeResumeButton.FocusAsync() : ValueTask.CompletedTask;
    }

    /// <summary>The Notice's "Resume now" (FR-010): a refusal shows in the Notice's place.</summary>
    private async Task ResumeFromNoticeAsync()
    {
        var refusal = await ResumeAsync();
        _resumeRefusal = refusal;
    }

    /// <summary>The Pauses card's "Resume now" on the current pause (FR-010): a refusal shows under the card title.</summary>
    private async Task ResumeFromCardAsync(PauseView pause)
    {
        var refusal = await ResumeAsync();
        _pausesRefusal = refusal;
    }

    /// <summary>
    /// Resumes the goal, then reads everything again, also after a refusal, so the Notice, "Pause", the cards and the
    /// figures agree; the focus then goes to "Pause". Returns the refusal's text, or null.
    /// </summary>
    private async Task<string?> ResumeAsync()
    {
        var result = await UseCases.RunAsync<PauseService, ResumeResult>(
            (service, token) => service.ResumeAsync(_actingUser, new GoalId(Id), token), CancellationToken.None);
        await ReadRecordsAsync();
        _removeRefusal = null;
        _focusPauseAfterRender = true;
        return result.Outcome == ResumeOutcome.Resumed ? null : result.Message;
    }

    /// <summary>
    /// The Pauses card's "Cancel pause" on an upcoming pause (FR-011): cancels it, then reads everything again, also after
    /// a refusal, which shows under the card title; the focus then goes to "Pause", or to the Notice's "Resume now".
    /// </summary>
    private async Task CancelPauseAsync(PauseView pause)
    {
        var id = pause.Id;
        var result = await UseCases.RunAsync<PauseService, CancelPauseResult>(
            (service, token) => service.CancelPauseAsync(_actingUser, new GoalId(Id), id, token), CancellationToken.None);
        await ReadRecordsAsync();
        _removeRefusal = null;
        _pausesRefusal = result.Outcome == CancelPauseOutcome.Cancelled ? null : result.Message;
        _focusPauseAfterRender = true;
    }

    private void OpenNote(HistoryEntry row)
    {
        _noteRow = row;
        _noteOpen = true;
    }

    private void CloseNote() => _noteOpen = false;

    /// <summary>Reads again first, so the render that closes the dialog has the row's new note and the new Recent notes.</summary>
    private async Task NoteSavedAsync(HistoryEntry entry)
    {
        await ReadRecordsAsync();
        _removeRefusal = null;
        _noteOpen = false;
    }

    private ValueTask FocusNoteRowAsync() =>
        _noteRow is { } row && _historyCard is { } card ? card.FocusNoteAsync(row.FirstDate) : ValueTask.CompletedTask;

    private ValueTask FocusRowAsync() =>
        _row is { } row && _historyCard is { } card ? card.FocusAsync(row.FirstDate, _editing?.Id) : ValueTask.CompletedTask;

    /// <summary>The GoalStats strip: the states of the report's latest ended results, oldest first (FR-005).</summary>
    private static IReadOnlyList<EvaluationState> StripOf(GoalReport report) =>
        report.Recent.Results.Select(result => result.State).ToList();

    /// <summary>
    /// The latest attempt's line (slice 4 HP-004, slice 8 HP-001, HP-008), from <see cref="ReportText"/>: "Attempt 2 ·
    /// started 18 Nov" once it has begun, "Attempt 2 · starts 23 Nov" while it has not (<see cref="GoalDetails.AttemptHasBegun"/>,
    /// not <see cref="GoalDetails.HasStarted"/>), and "Attempt 1 · ended before it began" for an ended latest attempt that
    /// never began (it has no date; plan "Spec discrepancies" 5).
    /// </summary>
    private static string AttemptLine(GoalDetails goal) => goal switch
    {
        { IsEnded: true, AttemptHasBegun: false } => ReportText.AttemptWithoutDate(goal.AttemptNumber),
        { AttemptHasBegun: true } => ReportText.AttemptStarted(goal.AttemptNumber, goal.AttemptStartDate),
        _ => ReportText.AttemptStarts(goal.AttemptNumber, goal.AttemptStartDate),
    };
}
