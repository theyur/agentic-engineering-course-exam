@using HT.Ui.Habits
@* design/pages/PageCustomHabit, slice 4 state (HP-007, US4-AS13, US5-AS6): the habit fields, primary "Save and create
   goal", secondary "Save habit" and ghost Cancel, and the privacy card. No "Suggest for catalog" (slice 10). Both
   save buttons submit the form; the one that was pressed (Enter presses the first) decides which callback runs, and
   the page decides what each does. One refusal at a time sits under its field; the page may add an action at the
   right (Delete). Disabled, the whole form can no longer be saved. *@
<div class="ht-grid-2">
    <EditForm Model="Model" OnSubmit="SubmitAsync" class="ht-card" FormName="custom-habit">
        <fieldset class="ht-fieldset" disabled="@Disabled">
            <HabitFieldsEditor Model="Model" Error="Error" IdPrefix="custom-habit" NameHelp="@NameHelp" />
            <div class="ht-form-actions">
                <HtButton Type="submit" @onclick="() => _createGoal = true">Save and create goal</HtButton>
                <HtButton Type="submit" Variant="HtButton.ButtonVariant.Secondary" @onclick="() => _createGoal = false">Save habit</HtButton>
                <HtButton Variant="HtButton.ButtonVariant.Ghost" Href="/custom-habits">Cancel</HtButton>
                @if (EndAction is not null)
                {
                    <span class="ht-spacer"></span>
                    @EndAction
                }
            </div>
        </fieldset>
    </EditForm>
    <aside class="ht-card ht-sticky" aria-labelledby="custom-habit-privacy">
        <h2 class="ht-card__title ht-card__title--accent" id="custom-habit-privacy">Private</h2>
        <div class="ht-goal">Only you can see custom habits. Admins cannot see them.</div>
        <div class="ht-goal">They never appear in the catalog or in community statistics.</div>
    </aside>
</div>

@code {
    [Parameter, EditorRequired]
    public HabitFormModel Model { get; set; } = new();

    /// <summary>The refusal to show under its field.</summary>
    [Parameter]
    public FormError? Error { get; set; }

    /// <summary>The help under Name; none when null.</summary>
    [Parameter]
    public string? NameHelp { get; set; }

    /// <summary>True when the form can no longer be saved (the habit does not exist any more).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>"Save habit".</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>"Save and create goal".</summary>
    [Parameter]
    public EventCallback OnSaveAndCreateGoal { get; set; }

    /// <summary>An action pushed to the right of Save and Cancel, such as "Delete".</summary>
    [Parameter]
    public RenderFragment? EndAction { get; set; }

    /// <summary>
    /// Which save button submitted the form. A submit that pressed no button, such as Enter in a field, counts as the
    /// first one, as the browser's implicit submission does.
    /// </summary>
    private bool _createGoal = true;

    private Task SubmitAsync()
    {
        var createGoal = _createGoal;
        _createGoal = true;
        return createGoal ? OnSaveAndCreateGoal.InvokeAsync() : OnSave.InvokeAsync();
    }
}
