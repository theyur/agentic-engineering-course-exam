{
  "permissions": {
    "deny": [
      "Skill(pr-review)",
      "Skill(pr-review *)",
      "mcp__greptile__trigger_code_review"
    ]
  },
  "skillOverrides": {
    "pr-review": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/architecture-gate.ps1\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/architecture-gate.ps1\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-pr-review.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python -I \"$CLAUDE_PROJECT_DIR/.specify/extensions/ac/hooks/guard.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "pr-review",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-pr-review.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "sdlc": {
      "source": {
        "source": "directory",
        "path": "E:\\Personal\\agentic-engineering-course\\sdlc"
      }
    }
  },
  "enabledPlugins": {
    "sdlc@sdlc": true
  }
}
