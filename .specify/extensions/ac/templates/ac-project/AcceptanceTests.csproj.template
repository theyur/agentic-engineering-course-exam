<Project Sdk="Microsoft.NET.Sdk">

  <!-- Acceptance tests of the spec-kit AC workflow (spec-kit-ac). Generated by /speckit-ac-init.
       Not in the solution file on purpose: built and run only by the /speckit-ac-* commands. -->

  <PropertyGroup>
    <TargetFramework>{{TARGET_FRAMEWORK}}</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Defaults only: settings from the root Directory.Build.props win. -->
    <ImplicitUsings Condition="'$(ImplicitUsings)' == ''">enable</ImplicitUsings>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
{{PROPERTIES}}    <!-- Generated .feature.cs goes to obj, so Features/ holds only the translator's .feature files (and their lock). -->
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
    <Using Include="{{ASSERT_NAMESPACE}}" />
  </ItemGroup>
{{FRAMEWORK_REFERENCES}}
  <ItemGroup>
    <None Include="Samples/**" CopyToOutputDirectory="PreserveNewest" />
{{RUNNER_CONFIG}}  </ItemGroup>

  <!-- Ref mode: used only by ac-feature-translator and ac-test-writer to compile. Never executed.
       Every reference assembly export_refs.py writes to the refs folder is referenced. -->
  <ItemGroup Condition="'$(AcRefMode)' == 'true'">
    <Reference Include="$(MSBuildThisFileDirectory){{REFS_DIR}}/*.dll" Private="false" />
  </ItemGroup>

  <!-- Normal mode: the real implementation, used by /speckit-ac-tests-analyze. -->
  <ItemGroup Condition="'$(AcRefMode)' != 'true'">
{{PROJECT_REFERENCES}}  </ItemGroup>

</Project>
